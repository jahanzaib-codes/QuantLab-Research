# ==============================================================================
# QuantLab-Research Environment Configuration Template
# ==============================================================================

# Research Environment
QUANT_ENV=research
DEFAULT_RISK_FREE_RATE=0.045  # 4.5% annual risk-free benchmark rate
DEFAULT_BENCHMARK_TICKER=SPY
DEFAULT_BACKTEST_CAPITAL=100000.0

# Transaction Costs Modeling
SLIPPAGE_BPS=3.0  # 3 basis points
COMMISSION_PER_SHARE=0.005  # $0.005 per share
TRANSACTION_FEE_PCT=0.0005  # 5 bps for crypto

# Data Cache
CACHE_ENABLED=true
DATA_DIR=data/
